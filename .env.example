# https://musclewiki.com
MUSCLE_WIKI_API_KEY=
# https://console.typesafe.ai (Coach message classification)
TYPESAFE_API_KEY=
# Optional: pinned to match the previous Jev version; use jev-latest to follow stable releases
TYPESAFE_MODEL=jev-1.13.0
# Generation uses Codex CLI signed in with ChatGPT, not an API key.
# Optional: absolute CLI path if codex is not on the app service's PATH.
CODEX_BIN=
# Optional: Codex authentication directory (defaults to the service user's ~/.codex).
CODEX_HOME=
